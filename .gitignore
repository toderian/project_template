.idea

# Local drop-zone, scratch, and machine bindings. Never committed.
.local/
.no-commit/

# Local credentials for agent/tool use. Never commit.
.creds/

# Python bytecode.
__pycache__/
*.pyc

# Local Claude Code settings (per-machine permissions, hooks). The trailing *
# also covers the harness's atomic-write temp files.
.claude/settings.local.json*

# Local Codex config/state.
.codex/*

# execute-plan run evidence that is regenerable
docs/_plans/_runs/**/diff.patch
docs/_plans/_runs/**/*.patch
docs/_plans/_runs/*/lock

# Worktrees the harness makes for isolated subagents.
.claude/worktrees/
