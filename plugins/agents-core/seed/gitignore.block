# Managed by `at init` (agents-template). Keep project-specific rules outside this block.

# Local drop-zone, scratch, and machine bindings. Never committed.
.inbox/
.local/
.no-commit/

# Local credentials for agent/tool use. Never commit.
.creds/

# Local Python virtual environments. Commit uv metadata, never the env itself.
.venv/
tools/python/.venv/
__pycache__/
*.pyc

# Local Claude Code settings (per-machine permissions, hooks). The trailing *
# also covers the harness's atomic-write temp files.
.claude/settings.local.json*

# Local caveman switch (seeded by `at init`): edit defaultMode to "off" for this checkout only.
# A committed .caveman/config.json sets a repo-wide default instead.
.caveman.json

# Local Codex config/state. Only committed project-scoped agent mirrors are allowed.
.codex/*
!.codex/agents/
.codex/agents/*
!.codex/agents/*.toml

# Worktrees and scratch dirs.
.worktrees/
worktrees/
.tmp/
tmp/
temp/

# Local environment config (copy from project.env.example).
project.env
