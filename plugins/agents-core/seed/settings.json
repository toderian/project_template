{
  "extraKnownMarketplaces": {
    "agents-template": {
      "source": {
        "source": "github",
        "repo": "toderian/project_template"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "enabledPlugins": {
    "agents-core@agents-template": true,
    "caveman@caveman": true
  },
  "permissions": {
    "deny": [
      "Read(./.creds/**)",
      "Edit(./.creds/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/statusline.sh\""
  }
}
